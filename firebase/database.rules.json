{
  "rules": {
    ".read": false,
    ".write": false,

    "adminRoles": {
      ".read": "auth != null && (auth.uid === '2M2ZdLQcJAhluPjUVFNJ6MyQrdH2' || auth.token.email === 'dmb23930@gmail.com')",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.uid === '2M2ZdLQcJAhluPjUVFNJ6MyQrdH2' || auth.token.email === 'dmb23930@gmail.com')",
        ".write": "auth != null && (auth.uid === '2M2ZdLQcJAhluPjUVFNJ6MyQrdH2' || auth.token.email === 'dmb23930@gmail.com')",
        ".validate": "newData.hasChildren(['email', 'siteAdmin', 'matcenterAdmin', 'contentEditor', 'dutyEditor', 'englishAccess', 'updatedAt', 'updatedBy'])",
        "email": { ".validate": "newData.isString() && newData.val().length <= 254" },
        "siteAdmin": { ".validate": "newData.isBoolean()" },
        "matcenterAdmin": { ".validate": "newData.isBoolean()" },
        "contentEditor": { ".validate": "newData.isBoolean()" },
        "dutyEditor": { ".validate": "newData.isBoolean()" },
        "englishAccess": { ".validate": "newData.isBoolean()" },
        "updatedAt": { ".validate": "newData.isNumber()" },
        "updatedBy": { ".validate": "newData.isString() && newData.val() === auth.uid" },
        "$other": { ".validate": false }
      }
    },

    "classDuty": {
      "grade10_1": {
        ".read": true,
        ".write": "auth != null && newData.exists() && (auth.uid === '2M2ZdLQcJAhluPjUVFNJ6MyQrdH2' || auth.token.email === 'dmb23930@gmail.com' || root.child('adminRoles').child(auth.uid).child('dutyEditor').val() === true)",
        ".validate": "newData.hasChildren(['version', 'className', 'academicYear', 'revision', 'updatedAt', 'updatedBy', 'entries']) && newData.child('revision').val() === (data.exists() ? data.child('revision').val() + 1 : 1)",
        "version": { ".validate": "newData.isNumber() && newData.val() === 1" },
        "className": { ".validate": "newData.isString() && newData.val() === '10-1'" },
        "academicYear": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20" },
        "revision": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() % 1 === 0" },
        "updatedAt": { ".validate": "newData.isNumber()" },
        "updatedBy": { ".validate": "newData.isString() && newData.val() === auth.uid" },
        "entries": {
          ".validate": "newData.hasChildren()",
          "$week": {
            ".validate": "$week.matches(/^week-[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && newData.hasChildren(['start', 'end', 'people', 'note'])",
            "start": { ".validate": "newData.isString() && newData.val().length === 10 && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)" },
            "end": { ".validate": "newData.isString() && newData.val().length === 10 && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)" },
            "people": {
              ".validate": "newData.hasChildren()",
              "$person": { ".validate": "$person.matches(/^person-[0-9]+$/) && newData.isString() && newData.val().length > 0 && newData.val().length <= 120" }
            },
            "note": { ".validate": "newData.isString() && newData.val().length <= 500" },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    },

    "accountDirectory": {
      ".read": "auth != null && (auth.uid === '2M2ZdLQcJAhluPjUVFNJ6MyQrdH2' || auth.token.email === 'dmb23930@gmail.com' || root.child('adminRoles').child(auth.uid).child('siteAdmin').val() === true)",
      "$uid": {
        ".write": "auth != null && ((auth.uid === $uid && newData.exists()) || auth.uid === '2M2ZdLQcJAhluPjUVFNJ6MyQrdH2' || auth.token.email === 'dmb23930@gmail.com' || root.child('adminRoles').child(auth.uid).child('siteAdmin').val() === true)",
        ".validate": "newData.hasChildren(['email', 'displayName', 'lastSeen'])",
        "email": { ".validate": "newData.isString() && newData.val().length <= 254 && (auth.uid !== $uid || newData.val() === auth.token.email)" },
        "displayName": { ".validate": "newData.isString() && newData.val().length <= 120" },
        "lastSeen": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },

    "presence": {
      ".read": "auth != null && (auth.token.email === 'dmb23930@gmail.com' || root.child('adminRoles').child(auth.uid).child('siteAdmin').val() === true)",
      "$visitorId": {
        ".write": true,
        "visitorId": { ".validate": "newData.isString() && newData.val() === $visitorId" },
        "page": { ".validate": "newData.isString() && newData.val().length <= 180" },
        "pageTitle": { ".validate": "newData.isString() && newData.val().length <= 180" },
        "timestamp": { ".validate": "newData.isNumber()" },
        "userAgent": { ".validate": "newData.isString() && newData.val().length <= 120" },
        "$other": { ".validate": false }
      }
    },

    "analyticsSessions": {
      ".read": "auth != null && (auth.token.email === 'dmb23930@gmail.com' || root.child('adminRoles').child(auth.uid).child('siteAdmin').val() === true)",
      "$day": {
        "$visitorId": {
          "$sessionId": {
            ".write": "newData.exists() || (auth != null && (auth.token.email === 'dmb23930@gmail.com' || root.child('adminRoles').child(auth.uid).child('siteAdmin').val() === true))",
            ".validate": "newData.hasChildren(['visitorId', 'page', 'pageTitle', 'startedAt', 'lastActive', 'durationSeconds', 'device', 'referrerHost'])",
            "visitorId": { ".validate": "newData.isString() && newData.val() === $visitorId" },
            "page": { ".validate": "newData.isString() && newData.val().length <= 180" },
            "pageTitle": { ".validate": "newData.isString() && newData.val().length <= 180" },
            "startedAt": { ".validate": "newData.isNumber()" },
            "lastActive": { ".validate": "newData.isNumber()" },
            "durationSeconds": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 86400" },
            "device": { ".validate": "newData.val() === 'mobile' || newData.val() === 'tablet' || newData.val() === 'desktop'" },
            "referrerHost": { ".validate": "newData.isString() && newData.val().length <= 120" },
            "$other": { ".validate": false }
          }
        }
      }
    },

    "polls": {
      ".read": true,
      ".write": "auth != null && (auth.token.email === 'dmb23930@gmail.com' || root.child('adminRoles').child(auth.uid).child('siteAdmin').val() === true)",
      ".indexOn": ["active", "createdAt"]
    },

    "pollResponses": {
      ".read": "auth != null && (auth.token.email === 'dmb23930@gmail.com' || root.child('adminRoles').child(auth.uid).child('siteAdmin').val() === true)",
      "$pollId": {
        "$visitorId": {
          ".write": "!data.exists()",
          ".validate": "newData.hasChildren(['optionIndex', 'optionText', 'timestamp', 'page'])",
          "optionIndex": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 20" },
          "optionText": { ".validate": "newData.isString() && newData.val().length <= 240" },
          "timestamp": { ".validate": "newData.isNumber()" },
          "page": { ".validate": "newData.isString() && newData.val().length <= 180" },
          "$other": { ".validate": false }
        }
      }
    },

    "visitors": {
      ".read": "auth != null && (auth.token.email === 'dmb23930@gmail.com' || root.child('adminRoles').child(auth.uid).child('siteAdmin').val() === true)",
      "$visitorId": {
        ".write": "newData.exists() || (auth != null && (auth.token.email === 'dmb23930@gmail.com' || root.child('adminRoles').child(auth.uid).child('siteAdmin').val() === true))",
        "id": { ".validate": "newData.isString() && newData.val() === $visitorId" },
        "lastVisit": { ".validate": "newData.isNumber()" },
        "lastPage": { ".validate": "newData.isString() && newData.val().length <= 180" },
        "visitCount": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "$other": { ".validate": false }
      }
    },

    "dailyStats": {
      ".read": "auth != null && (auth.token.email === 'dmb23930@gmail.com' || root.child('adminRoles').child(auth.uid).child('siteAdmin').val() === true)",
      "$day": {
        "$visitorId": {
          ".write": "newData.val() === true",
          ".validate": "newData.isBoolean()"
        }
      }
    },

    "visitorNames": {
      ".read": "auth != null && (auth.token.email === 'dmb23930@gmail.com' || root.child('adminRoles').child(auth.uid).child('siteAdmin').val() === true)",
      ".write": "auth != null && (auth.token.email === 'dmb23930@gmail.com' || root.child('adminRoles').child(auth.uid).child('siteAdmin').val() === true)"
    },

    "directMessages": {
      ".read": "auth != null && (auth.token.email === 'dmb23930@gmail.com' || root.child('adminRoles').child(auth.uid).child('siteAdmin').val() === true)",
      ".write": "auth != null && (auth.token.email === 'dmb23930@gmail.com' || root.child('adminRoles').child(auth.uid).child('siteAdmin').val() === true)",
      "$visitorId": {
        ".read": true,
        "$msgId": {
          "read": { ".write": true, ".validate": "newData.isBoolean()" },
          "readAt": { ".write": true, ".validate": "newData.isNumber()" }
        }
      }
    },

    "bookmarks": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "ticketBuilder": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "publicTickets": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "kc": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "matcenterSolved": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "englishVocabulary": {
      ".read": "auth != null && (auth.uid === '2M2ZdLQcJAhluPjUVFNJ6MyQrdH2' || auth.token.email === 'dmb23930@gmail.com' || root.child('adminRoles').child(auth.uid).child('englishAccess').val() === true)",
      ".write": "auth != null && (auth.uid === '2M2ZdLQcJAhluPjUVFNJ6MyQrdH2' || auth.token.email === 'dmb23930@gmail.com')",
      "$release": {
        ".validate": "newData.hasChildren(['version', 'updatedAt', 'items'])",
        "version": { ".validate": "newData.isNumber() && newData.val() === 1" },
        "updatedAt": { ".validate": "newData.isNumber()" },
        "items": {
          "$item": {
            ".validate": "newData.hasChildren(['number', 'term', 'definition', 'translationTerm', 'translation'])",
            "number": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 1000" },
            "term": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120" },
            "definition": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 600" },
            "translationTerm": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 160" },
            "translation": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 800" },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    },

    "noteDrafts": {
      "$subject": {
        ".read": "auth != null && (auth.token.email === 'dmb23930@gmail.com' || root.child('adminRoles').child(auth.uid).child('contentEditor').val() === true)",
        "$sectionId": {
          ".write": "auth != null && (auth.token.email === 'dmb23930@gmail.com' || root.child('adminRoles').child(auth.uid).child('contentEditor').val() === true)",
          ".validate": "newData.hasChildren(['schemaVersion', 'id', 'subject', 'title', 'navTitle', 'order', 'revision', 'createdAt', 'updatedAt', 'updatedBy', 'reviewStatus']) && (newData.child('blocks').exists() || newData.child('subsections').exists()) && newData.child('id').val() === $sectionId && newData.child('subject').val() === $subject",
          "schemaVersion": { ".validate": "newData.isNumber() && newData.val() === 1" },
          "id": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 64" },
          "subject": { ".validate": "newData.val() === 'physics' || newData.val() === 'math' || newData.val() === 'geometry' || newData.val() === 'chemistry' || newData.val() === 'likbez' || newData.val() === 'physics-10' || newData.val() === 'chemistry-10' || newData.val() === 'literature-10'" },
          "title": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 140" },
          "navTitle": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 90" },
          "blocks": { ".validate": "newData.exists()" },
          "subsections": { ".validate": "newData.exists()" },
          "order": { ".validate": "newData.isNumber()" },
          "revision": { ".validate": "newData.isNumber() && newData.val() >= 1" },
          "createdAt": { ".validate": "newData.isNumber()" },
          "updatedAt": { ".validate": "newData.isNumber()" },
          "updatedBy": { ".validate": "newData.isString() && newData.val() === auth.uid" },
          "reviewStatus": { ".validate": "newData.val() === 'draft' || newData.val() === 'ready' || newData.val() === 'published'" },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
